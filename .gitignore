# --- Python ---
__pycache__/
**/__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg-info/
build/
dist/
wheels/

# --- Tool caches ---
.mypy_cache/
.ruff_cache/
.pytest_cache/
.hypothesis/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/
*.venv

# --- Secrets & environment (the .env.example template stays tracked) ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Logs & local databases ---
*.log
*.sqlite
*.sql

# --- Internal design / planning / handoff docs (kept LOCAL, never published) ---
# .gitignore does NOT delete these — they remain on disk, just untracked. Move
# any doc here that carries internal strategy, provenance, or security detail.
AGENTS.md
CLAUDE.md
DESIGN.md
DEPLOY.md
PLAN.md
notes/
internal/
docs/internal/
scratch/
*.local.md
scripts/

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
