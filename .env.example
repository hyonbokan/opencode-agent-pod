# opencode-agent-pod — environment template.
# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# --- Runtime ---
ENVIRONMENT=development            # development | production (log level, etc.)

# --- Service auth (internal, trusted-network only) ---
# Shared bearer token callers must present. Use a long random value.
AGENT_POD_TOKEN=

# --- Provider API keys (held in the pod; never returned to callers) ---
# Set only the ones you use. Names match what opencode reads from the environment.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=                    # aliased to GOOGLE_GENERATIVE_AI_API_KEY for opencode
XAI_API_KEY=

# --- Custom OpenAI-compatible provider (local vLLM, etc.) — gated on G1 (PLAN.md) ---
# Enable once G1 is resolved; the pod points opencode at this base URL.
# CUSTOM_LLM_BASE_URL=http://vllm:8000/v1
# CUSTOM_LLM_API_KEY=

# --- opencode ---
# Pin a known-good version; gate upgrades with the version-gate check.
OPENCODE_VERSION=1.17.18

# --- Runner tuning (was config.scan.* in the source layer) ---
SDK_GLOBAL_CONCURRENCY=7
SDK_SERVE_STARTUP_TIMEOUT=60
